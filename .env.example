# Directory containing only the Logisim projects the bridge may access (its security boundary).
LOGISIM_PROJECT_ROOT=C:\Users\you\Documents\LogisimProjects

# Logisim Evolution 5.0.0 JAR (scripts/install-windows.ps1 downloads and verifies it).
LOGISIM_EVOLUTION=C:\Tools\logisim-live-mcp\tools\logisim-evolution-5.0.0-all.jar

# Optional when java is already on PATH (Java 21+).
JAVA=C:\Program Files\Eclipse Adoptium\jdk-21\bin\java.exe

# Optional live-plugin settings.
# LOGISIM_MCP_LIVE_PORT=51235
# LOGISIM_MCP_PLUGIN_JAR=C:\path\to\logisim-mcp-live-plugin.jar
# LOGISIM_MCP_STATE_DIR=C:\Users\you\.logisim-mcp
# LOGISIM_MCP_ARCHIVE_AUTOSAVES=0
